<?xml version="1.0" standalone="no" ?>

<!-- Million Module March - SPLIT mode with surging metering.
     A 2x5x2 block (20 catoms) marches +x around a 1-wide central pillar at x=9
     (y=5, full z). The APF infers mode=split; the goal box spans both side
     openings; surging metering drains the body around the divider front-first.
     clearance="1"; obstacles are never pivots. -->

<world gridSize="24,11,4" windowSize="1800,900"
       marchAxis="x" marchDir="1" marchSteps="22" marchStride="1"
       adaptiveBox="true" clearance="1">
    <camera target="120,55,15" directionSpherical="-30,28,320" angle="40"/>
    <spotlight target="120,55,10" directionSpherical="-30,50,310" angle="50"/>
    <blockList color="200,200,200" blockSize="10,10,10">
        <block position="1,3,0"/>
        <block position="1,3,1"/>
        <block position="1,4,0"/>
        <block position="1,4,1"/>
        <block position="1,5,0"/>
        <block position="1,5,1"/>
        <block position="1,6,0"/>
        <block position="1,6,1"/>
        <block position="1,7,0"/>
        <block position="1,7,1"/>
        <block position="2,3,0"/>
        <block position="2,3,1"/>
        <block position="2,4,0"/>
        <block position="2,4,1"/>
        <block position="2,5,0"/>
        <block position="2,5,1"/>
        <block position="2,6,0"/>
        <block position="2,6,1"/>
        <block position="2,7,0"/>
        <block position="2,7,1"/>
        <block position="9,5,0" obstacle="true"/>
        <block position="9,5,1" obstacle="true"/>
        <block position="9,5,2" obstacle="true"/>
        <block position="9,5,3" obstacle="true"/>
    </blockList>
</world>
