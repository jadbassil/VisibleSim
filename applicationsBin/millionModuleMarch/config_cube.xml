<?xml version="1.0" standalone="no" ?>

<!-- Million Module March - larger demo.
     A 3x3x3 cube (27 catoms) marches over a two-tall obstacle. The whole robot
     shifts forward and reaches each goal box.

     Note: do NOT put XML comments inside <targetList> - the core parser does
     not skip them. -->

<world gridSize="16,7,5" windowSize="1800,900">

    <camera target="75,35,20" directionSpherical="-30,28,200" angle="40"/>
    <spotlight target="75,35,15" directionSpherical="-30,50,190" angle="50"/>

    <blockList color="200,200,200" blockSize="10,10,10">

        <!-- Robot: 3x3x3 cube at the -x end -->
        <block position="1,2,0"/>
        <block position="2,2,0"/>
        <block position="3,2,0"/>
        <block position="1,3,0"/>
        <block position="2,3,0"/>
        <block position="3,3,0"/>
        <block position="1,4,0"/>
        <block position="2,4,0"/>
        <block position="3,4,0"/>
        <block position="1,2,1"/>
        <block position="2,2,1"/>
        <block position="3,2,1"/>
        <block position="1,3,1"/>
        <block position="2,3,1"/>
        <block position="3,3,1"/>
        <block position="1,4,1"/>
        <block position="2,4,1"/>
        <block position="3,4,1"/>
        <block position="1,2,2"/>
        <block position="2,2,2"/>
        <block position="3,2,2"/>
        <block position="1,3,2"/>
        <block position="2,3,2"/>
        <block position="3,3,2"/>
        <block position="1,4,2"/>
        <block position="2,4,2"/>
        <block position="3,4,2"/>

        <!-- Two-tall obstacle wall to march over -->
        <block position="8,2,0" obstacle="true"/>
        <block position="8,3,0" obstacle="true"/>
        <block position="8,4,0" obstacle="true"/>
        <block position="8,2,1" obstacle="true"/>
        <block position="8,3,1" obstacle="true"/>
        <block position="8,4,1" obstacle="true"/>

    </blockList>

    <targetList>
        <target format="grid">
            <cell position="5,2,0"/>
            <cell position="6,2,0"/>
            <cell position="7,2,0"/>
            <cell position="5,3,0"/>
            <cell position="6,3,0"/>
            <cell position="7,3,0"/>
            <cell position="5,4,0"/>
            <cell position="6,4,0"/>
            <cell position="7,4,0"/>
            <cell position="5,2,1"/>
            <cell position="6,2,1"/>
            <cell position="7,2,1"/>
            <cell position="5,3,1"/>
            <cell position="6,3,1"/>
            <cell position="7,3,1"/>
            <cell position="5,4,1"/>
            <cell position="6,4,1"/>
            <cell position="7,4,1"/>
            <cell position="5,2,2"/>
            <cell position="6,2,2"/>
            <cell position="7,2,2"/>
            <cell position="5,3,2"/>
            <cell position="6,3,2"/>
            <cell position="7,3,2"/>
            <cell position="5,4,2"/>
            <cell position="6,4,2"/>
            <cell position="7,4,2"/>
        </target>
        <target format="grid">
            <cell position="10,2,0"/>
            <cell position="11,2,0"/>
            <cell position="12,2,0"/>
            <cell position="10,3,0"/>
            <cell position="11,3,0"/>
            <cell position="12,3,0"/>
            <cell position="10,4,0"/>
            <cell position="11,4,0"/>
            <cell position="12,4,0"/>
            <cell position="10,2,1"/>
            <cell position="11,2,1"/>
            <cell position="12,2,1"/>
            <cell position="10,3,1"/>
            <cell position="11,3,1"/>
            <cell position="12,3,1"/>
            <cell position="10,4,1"/>
            <cell position="11,4,1"/>
            <cell position="12,4,1"/>
            <cell position="10,2,2"/>
            <cell position="11,2,2"/>
            <cell position="12,2,2"/>
            <cell position="10,3,2"/>
            <cell position="11,3,2"/>
            <cell position="12,3,2"/>
            <cell position="10,4,2"/>
            <cell position="11,4,2"/>
            <cell position="12,4,2"/>
        </target>
    </targetList>

</world>
